# Writes OUT with a hash of SOURCES (a |-separated list), so the effect can tell its builds apart.
string(REPLACE "|" ";" SOURCES "${SOURCES}")
set(combined "")
foreach(source IN LISTS SOURCES)
    file(SHA256 "${source}" hash)
    string(APPEND combined "${hash}")
endforeach()
string(SHA256 stamp "${combined}")
file(WRITE "${OUT}" "// Generated by cmake/BuildStamp.cmake from the sources that shape the pixels.\n"
                    "#define FEEDBACK_BUILD_STAMP \"${stamp}\"\n")
